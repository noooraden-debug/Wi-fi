{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WiFi Hub configuration",
  "type": "object",
  "required": ["app", "plans", "router"],
  "properties": {
    "app": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "owner": { "type": "string" },
        "whatsapp": { "type": "string", "description": "رقم واتساب بصيغة دولية بدون +" },
        "adminPass": { "type": "string" },
        "currency": { "type": "string" }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "autoApprove": { "type": "boolean" },
        "allowSelfService": { "type": "boolean" },
        "pollSeconds": { "type": "integer", "minimum": 15 },
        "features": { "type": "object" }
      }
    },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "days", "price"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "days": { "type": "integer" },
          "price": { "type": "number" },
          "maxDev": { "type": "integer" }
        }
      }
    },
    "router": {
      "type": "object",
      "required": ["username", "password"],
      "properties": {
        "base": { "type": "string", "description": "http://192.168.1.1 — اتركه فارغاً للاكتشاف التلقائي" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "sessionTimeout": { "type": "integer" },
        "wifiIfaces": { "type": "array", "items": { "type": "string" } }
      }
    },
    "codes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "plan": { "type": "string" },
          "maxDev": { "type": "integer" },
          "created": { "type": "number" },
          "expiresAt": { "type": "number" },
          "usedBy": { "type": "string" },
          "usedAt": { "type": "number" }
        }
      }
    },
    "subscribers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "username": { "type": "string" },
          "plan": { "type": "string" },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "maxDev": { "type": "integer" },
          "devices": { "type": "array" }
        }
      }
    },
    "requests": { "type": "array" },
    "logs": { "type": "array" }
  }
}
